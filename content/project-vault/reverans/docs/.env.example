NODE_ENV=production
PORT=3050
NEXT_PUBLIC_SITE_URL=https://example.com

# Auth
DATABASE_URL=postgresql://APP_USER:CHANGE_ME@127.0.0.1:5432/APP_DB
NEXTAUTH_SECRET=CHANGE_ME_LONG_RANDOM
NEXTAUTH_URL=https://example.com
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://example.com/api/auth/callback/yandex

# TBank — never commit real values
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=
TBANK_SECRET_FILE=/var/www/APP/secrets/tbank_secret
TBANK_API_URL=https://securepay.tinkoff.ru/v2
