# Reverans Service Harness
# Copy to config.env and adjust. Never commit real secrets.

HARNESS_HOST=159.194.228.226
HARNESS_USER=deploy
HARNESS_SSH_KEY=~/.ssh/reverans_deploy_ed25519
HARNESS_SSH_PORT=22

# Disk: fail if used % exceeds this
HARNESS_DISK_WARN_PCT=80
HARNESS_DISK_FAIL_PCT=92

# Memory: warn if available MiB below this
HARNESS_MEM_WARN_MIB=200

# Optional HTTP checks (enable after app + domain are live)
# HARNESS_HTTP_URL=https://example.com/api/health
# HARNESS_HTTP_EXPECT=200

# When app runs under PM2, set process name(s) space-separated
# HARNESS_PM2_APPS="reverans"
