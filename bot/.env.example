# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Канал для публикации: @username или числовой chat_id (например -1001234567890)
TELEGRAM_CHANNEL_ID=

# Ключ DeepSeek для выжимки и AI-консультанта (уже есть в проекте)
DEEPSEEK_API_KEY=

# Авто-публикация еженедельной выжимки (true/false)
AUTO_APPROVE=true

# RSS блога для постинга
BLOG_RSS_URL=https://proektmap.ru/blog/rss.xml

# Telegram user_id админа для команды /digest (число, опционально)
ADMIN_ID=
