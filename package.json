    "start": "next start --port 3030",
    "voice:setup": "bash scripts/vaibik-voice/setup.sh",
    "voice:test": "bash scripts/vaibik-voice/run.sh test",
    "voice:generate": "bash scripts/vaibik-voice/run.sh all",
    "voice:check": "node scripts/vaibik-voice/check.mjs",
    "voice:guides": "python3 scripts/generate-voice-guides.py --provider=yandex",
