# ProektMap — настройки окружения
DATABASE_URL="postgresql://user:pass@localhost:5433/proektmap"
NEXTAUTH_URL="https://proektmap.ru"
NEXTAUTH_SECRET="generate-random-string-here"
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
DEEPSEEK_API_KEY="sk-..."
OPENROUTER_API_KEY=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Дневной лимит drip-публикации AI-постов (по умолчанию 2). См. src/lib/blog/daily-quota.ts
BLOG_AUTO_PUBLISH_DAILY_LIMIT="2"
CRON_SECRET=""
# Soft gate for /project-vault/[slug] engineering map (client-side; default 123456)
NEXT_PUBLIC_PROJECT_VAULT_PASS="123456"

# ИИ Форум (Flarum) SSO — docs/forum-architecture.md
# Секрет: openssl rand -hex 32. Тот же client_id/secret кладётся в config.php форума (блок proektmap_sso).
COMMUNITY_OAUTH_CLIENT_ID=proektmap-forum
COMMUNITY_OAUTH_CLIENT_SECRET=
COMMUNITY_OAUTH_REDIRECT_URI=https://proektmap.ru/community/auth/proektmap
# 1 = показывать ссылки «Обсудить на ИИ Форуме» на сайте (после снятия staging-пароля)
COMMUNITY_PUBLIC=0
